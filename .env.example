# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Configuration
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="Your direct database URL (same as DATABASE_URL for local development)"

# App origin (CORS whitelist). Local default:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed only (local). Required by `npm run seed`. Never commit real values.
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=